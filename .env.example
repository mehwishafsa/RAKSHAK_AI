# Copy to .env and adjust. All values are optional.

# SQLite file holding machines, parts, incidents and the trust ledger.
RAKSHAK_DB_PATH=./data/rakshak.db
# Built frontend served by FastAPI in single-service mode.
RAKSHAK_FRONTEND_DIST=./frontend/dist
# Seconds between simulation ticks (0.2 = 5 Hz telemetry).
RAKSHAK_TICK_SECONDS=0.2
# RNG seed for the sensor simulator (reproducible demo runs).
RAKSHAK_SIM_SEED=7
# Comma-separated origins allowed by CORS (only needed if the UI is served elsewhere).
RAKSHAK_CORS_ORIGINS=http://localhost:5173
# Dev launcher (scripts/dev.py) ports; it moves to the next free port if taken.
RAKSHAK_API_PORT=8000
RAKSHAK_WEB_PORT=5173
# Port the Docker image listens on (Render injects its own; don't set it there).
PORT=8000
